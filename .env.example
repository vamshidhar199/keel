# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# ── Postgres ──────────────────────────────────────────────────────────────────
# Mettrie metadata database (users, sessions, raw_events, llm_costs, etc.)
DATABASE_URL=postgresql://mettrie:mettrie_dev@localhost:5432/mettrie_meta

# Superuser connection used when provisioning a new user's gbrain database.
# Required in production (Railway). Leave unset in local dev — falls back to
# local socket peer auth automatically.
# Format: postgresql://postgres:<password>@<host>:5432/postgres
SUPER_DATABASE_URL=

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI must be: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# From console.anthropic.com → API Keys
# Used for Haiku (extraction) and Sonnet (page composition, query synthesis)
ANTHROPIC_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# From platform.openai.com → API Keys
# Required by gbrain to generate vector embeddings for semantic search (P4)
OPENAI_API_KEY=

# ── gbrain CLI ────────────────────────────────────────────────────────────────
# Path to the directory containing the bun binary (gbrain CLI uses a #!/usr/bin/env bun shebang).
# Default ~/.bun/bin works for most installs.
BUN_BIN=/Users/YOUR_USERNAME/.bun/bin

# ── Slack ─────────────────────────────────────────────────────────────────────
# From api.slack.com → Your Apps → OAuth & Permissions
# Redirect URL to add: ${NEXTAUTH_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Dev server runs on 3002 because port 3000 is often taken by other tools.
NEXTAUTH_URL=http://localhost:3002
