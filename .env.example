# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# ── Postgres ──────────────────────────────────────────────────────────────────
# Application role: non-superuser, NOBYPASSRLS. Used by all request traffic.
# In local dev, points to mettrie_app (created by setup.sh).
# In prod (Railway): postgresql://mettrie_app:<password>@<host>:5432/mettrie_meta
DATABASE_URL=postgresql://mettrie_app:mettrie_app_dev@localhost:5432/mettrie_meta

# Superuser connection used ONLY for migrations and admin scripts.
# In local dev: the mettrie role (superuser in the dev Docker container).
# In prod (Railway): postgresql://postgres:<password>@<host>:5432/mettrie_meta
ADMIN_DATABASE_URL=postgresql://mettrie:mettrie_dev@localhost:5432/mettrie_meta

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── At-rest encryption ────────────────────────────────────────────────────────
# Master key for AES-256-GCM encryption of OAuth tokens, user API keys,
# and raw Gmail/Slack message content (lib/crypto.ts).
# Generate with: openssl rand -base64 32
# WARNING: if this key is lost or rotated, all previously encrypted rows
# become unrecoverable. Store the prod value in a password manager.
ENCRYPTION_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI must be: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# From console.anthropic.com → API Keys
# Used for Haiku (extraction) and Sonnet (page composition, query synthesis)
ANTHROPIC_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# From platform.openai.com → API Keys
# Required for generating vector embeddings for semantic search
OPENAI_API_KEY=

# ── Slack ─────────────────────────────────────────────────────────────────────
# From api.slack.com → Your Apps → OAuth & Permissions
# Redirect URL to add: ${NEXTAUTH_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Background jobs ───────────────────────────────────────────────────────────
# Number of jobs to claim and run in parallel per drain() call.
WORKER_CONCURRENCY=3

# Optional shared secret for POST /api/queue/drain. If set, cron and self-trigger
# both send X-Queue-Secret: <value>. Leave empty in local dev.
QUEUE_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Dev server runs on 3002 because port 3000 is often taken by other tools.
NEXTAUTH_URL=http://localhost:3002
