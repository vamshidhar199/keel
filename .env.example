# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# ── Postgres ──────────────────────────────────────────────────────────────────
# Application role: non-superuser, NOBYPASSRLS. Used by all request traffic.
# In local dev, points to mettrie_app (created by setup.sh).
# In prod (Railway): postgresql://mettrie_app:<password>@<host>:5432/mettrie_meta
DATABASE_URL=postgresql://mettrie_app:mettrie_app_dev@localhost:5432/mettrie_meta

# Superuser connection used ONLY for migrations and admin scripts.
# In local dev: the mettrie role (superuser in the dev Docker container).
# In prod (Railway): postgresql://postgres:<password>@<host>:5432/mettrie_meta
ADMIN_DATABASE_URL=postgresql://mettrie:mettrie_dev@localhost:5432/mettrie_meta

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── At-rest encryption ────────────────────────────────────────────────────────
# Master key for AES-256-GCM encryption of OAuth tokens, user API keys,
# and raw Gmail/Slack message content (lib/crypto.ts).
# Generate with: openssl rand -base64 32
# WARNING: if this key is lost or rotated, all previously encrypted rows
# become unrecoverable. Store the prod value in a password manager.
ENCRYPTION_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI must be: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# From console.anthropic.com → API Keys
# Used for Haiku (extraction) and Sonnet (page composition, query synthesis).
# Only consumed when SHARED_KEY_MODE is 'trial' or 'org' (see below) —
# otherwise users must paste their own key in Settings → Developer.
ANTHROPIC_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# From platform.openai.com → API Keys
# Required for generating vector embeddings for semantic search.
# Only consumed when SHARED_KEY_MODE is 'trial' or 'org'.
OPENAI_API_KEY=

# ── Shared API key mode ──────────────────────────────────────────────────────
# How this deployment uses the ANTHROPIC_API_KEY / OPENAI_API_KEY above:
#
#   off    — Shared fallback disabled. Every user MUST paste their own keys
#            in Settings → Developer. Banner pushes them to do so.
#            Use for: public deploys where you don't want to pay for users.
#
#   trial  — Shared fallback active, treated as a TIME-LIMITED FREE TRIAL.
#            Banner shows "You're on the free trial" with budget hint and
#            a "Add your own keys" CTA.
#            Use for: a controlled trial period (e.g. Product Hunt launch).
#
#   org    — Shared fallback active, treated as the INTENDED setup. No
#            banner when both keys are missing — the shared key is policy.
#            /usage relabels "Free trial" → "Shared key".
#            Use for: solo deploys (you're the only user), or a
#            company-wide deploy where one corporate key serves all
#            employees.
#
# Default if unset:
#   - NODE_ENV != 'production': 'trial' (local "just works" with trial framing)
#   - NODE_ENV == 'production': 'off'   (safe by default for public deploys)
#
# Legacy SHARED_API_FALLBACK=true|false is honored as 'trial'|'off' when
# SHARED_KEY_MODE is unset.
#
# SHARED_KEY_MODE=org

# Daily USD ceiling for spend on the shared key (across ALL users), in any
# mode where shared fallback is active. When exceeded, shared calls fail
# with a friendly message. Per-user caps in callClaude / embedText still
# apply on top. Default $10/day if unset.
# SHARED_DAILY_USD_CAP=10

# ── Slack ─────────────────────────────────────────────────────────────────────
# From api.slack.com → Your Apps → OAuth & Permissions
# Redirect URL to add: ${NEXTAUTH_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Salesforce ────────────────────────────────────────────────────────────────
# From a Salesforce Connected App: Setup → App Manager → New Connected App.
# Enable OAuth, set Callback URL to ${NEXTAUTH_URL}/api/salesforce/callback,
# and select scopes: api, refresh_token, offline_access.
# Then click Manage Consumer Details to copy Consumer Key / Secret.
# Note: a new Connected App can take ~10 minutes to activate before OAuth works.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Background jobs ───────────────────────────────────────────────────────────
# Number of jobs to claim and run in parallel per drain() call.
WORKER_CONCURRENCY=3

# Optional shared secret for POST /api/queue/drain. If set, cron and self-trigger
# both send X-Queue-Secret: <value>. Leave empty in local dev.
QUEUE_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Dev server runs on 3002 because port 3000 is often taken by other tools.
NEXTAUTH_URL=http://localhost:3002
